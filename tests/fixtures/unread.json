{
  "$comment": "What a conversation and a network look like when something has happened. Read by tests/shared/unread.test.ts and the Android SharedCorpusTest. Three states and nothing else: grey for quiet, white for unread, a number for a mention.",
  "$rows": "One conversation in the list. `look` is grey/white/selected; `badge` is the number on it, null for none.",
  "rows": [
    {
      "name": "nothing has happened here",
      "unread": 0,
      "mentions": 0,
      "muted": false,
      "selected": false,
      "look": "quiet",
      "badge": null
    },
    {
      "name": "something was said",
      "unread": 3,
      "mentions": 0,
      "muted": false,
      "selected": false,
      "look": "unread",
      "badge": null,
      "$comment": "White, and no number. The phone used to put a grey count here, which made 'something was said' and 'you were named' both numbers \u2014 you had to read them to tell which was which."
    },
    {
      "name": "somebody said your name",
      "unread": 3,
      "mentions": 1,
      "muted": false,
      "selected": false,
      "look": "unread",
      "badge": {
        "count": 1,
        "muted": false
      }
    },
    {
      "name": "the one you are looking at is never shouting at you",
      "unread": 0,
      "mentions": 0,
      "muted": false,
      "selected": true,
      "look": "selected",
      "badge": null
    },
    {
      "$comment": "Muting is 'do not shout', not 'do not tell me'. The row stays grey and the count stays, greyed.",
      "name": "a muted conversation stays grey however much was said",
      "unread": 9,
      "mentions": 0,
      "muted": true,
      "selected": false,
      "look": "quiet",
      "badge": null
    },
    {
      "name": "and still counts a mention, quietly",
      "unread": 9,
      "mentions": 2,
      "muted": true,
      "selected": false,
      "look": "quiet",
      "badge": {
        "count": 2,
        "muted": true
      }
    }
  ],
  "$rails": "A network's item on the rail, given everything on that network. `chip` is the pill on the left edge.",
  "rails": [
    {
      "name": "a quiet network has no chip",
      "conversations": [
