{
  "$comment": "Finding the links in a line, shared by tests/shared/links.test.ts and the Android LinksTest. The two clients each had their own pattern and they disagreed: the desktop kept the full stop at the end of a sentence inside the URL and the phone dropped it, and both stopped dead at the first closing bracket — so every Wikipedia link with a disambiguation in it arrived truncated, on both.",
  "$cases": "`text` is the line; `links` are the URLs found in it, in order.",
  "cases": [
    {
      "name": "a bare link",
      "text": "https://example.com/a",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "a link in a sentence keeps the sentence's full stop out of it",
      "text": "look at https://example.com/a.",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "and its comma",
      "text": "https://example.com/a, and more",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "and its question mark",
      "text": "have you seen https://example.com/a?",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "a query string is not a question mark",
      "text": "https://example.com/a?v=2 next",
      "links": [
        "https://example.com/a?v=2"
      ]
    },
    {
      "name": "a bracket the URL opened belongs to the URL",
      "text": "https://en.wikipedia.org/wiki/Mercury_(planet)",
      "links": [
        "https://en.wikipedia.org/wiki/Mercury_(planet)"
      ]
    },
    {
      "name": "a bracket the sentence opened does not",
      "text": "(see https://example.com/a)",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "both at once",
      "text": "(see https://en.wikipedia.org/wiki/Mercury_(planet)).",
      "links": [
        "https://en.wikipedia.org/wiki/Mercury_(planet)"
      ]
    },
    {
      "name": "two links in one line",
      "text": "https://one.example/a and https://two.example/b",
      "links": [
        "https://one.example/a",
        "https://two.example/b"
      ]
    },
    {
      "name": "http as well as https",
      "text": "http://example.com/a",
      "links": [
        "http://example.com/a"
      ]
    },
    {
      "name": "ftp too",
      "text": "ftp://files.example.net/pub",
      "links": [
        "ftp://files.example.net/pub"
      ]
    },
    {
      "name": "a scheme with nothing after it is not a link",
      "text": "https://",
      "links": []
    },
    {
      "name": "no link at all",
      "text": "just talking about http things",
      "links": []
    },
    {
      "name": "a link in quotes",
      "text": "he said \"https://example.com/a\" then left",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "a colour code ends the address",
      "text": "\u000312https://example.com/a and after",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "a link followed by a colon",
      "text": "https://example.com/a: see",
      "links": [
        "https://example.com/a"
      ]
    },
    {
      "name": "a trailing slash is part of it",
      "text": "https://example.com/",
      "links": [
        "https://example.com/"
      ]
    },
    {
      "name": "a fragment is part of it",
      "text": "https://example.com/a#section here",
      "links": [
        "https://example.com/a#section"
      ]
    },
    {
      "name": "an apostrophe ends it, because a possessive is not an address",
      "text": "https://example.com/a's page",
      "links": [
        "https://example.com/a"
      ]
    }
  ],
  "$safe": "Whether a link is one we are willing to hand to the operating system. Everything that reaches `shell.openExternal` or an ACTION_VIEW intent will be attempted by whatever handles that scheme, and a profile's `homepage` is a metadata key — a string a stranger chose. `file:///` reads the machine; on Windows a handler scheme can start a program. `url` is null where the link must not be offered at all.",
  "safe": [
    {
      "name": "an ordinary https link",
      "value": "https://example.org/page",
      "url": "https://example.org/page"
    },
    {
      "name": "plain http, because plenty of homepages still are",
      "value": "http://example.org/",
      "url": "http://example.org/"
    },
    {
      "name": "mailto, because a contact link is a reasonable profile",
      "value": "mailto:someone@example.org",
      "url": "mailto:someone@example.org"
    },
    {
      "name": "trimmed",
      "value": "  https://example.org/  ",
      "url": "https://example.org/"
    },
    {
      "name": "a file URL reads this machine",
      "value": "file:///etc/passwd",
      "url": null
    },
    {
      "name": "and so does one dressed up",
      "value": "FILE:///C:/Windows/System32/config/SAM",
      "url": null
    },
    {
      "name": "javascript never reaches a browser from here, and must not reach the OS",
      "value": "javascript:alert(1)",
      "url": null
    },
    {
      "name": "a Windows handler scheme can start a program",
      "value": "ms-msdt:/id PCWDiagnostic",
      "url": null
    },
    {
      "name": "an SMB share is a credential leak on Windows",
      "value": "smb://attacker.example/share",
      "url": null
    },
    {
      "name": "ftp is found by the linkifier and still not opened",
      "value": "ftp://files.example.org/pub",
      "url": null
    },
    {
      "name": "data URLs are unbounded and go nowhere good",
      "value": "data:text/html,<script>alert(1)</script>",
      "url": null
    },
    {
      "name": "not a URL at all",
      "value": "example.org",
      "url": null
    },
    {
      "name": "http with no host is not a link to anywhere",
      "value": "http://",
      "url": null
    },
    {
      "name": "empty",
      "value": "",
      "url": null
    },
    {
      "name": "whitespace",
      "value": "   ",
      "url": null
    },
    {
      "name": "too long to be a homepage",
      "value": "https://example.",
      "url": null
    }
  ]
}
