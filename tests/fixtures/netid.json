{
  "note": "Which network a server entry is, independent of the id it was given. Read by tests/shared/netid.test.ts and SharedCorpusTest.",
  "same": [
    {
      "name": "the same host, port and nick is the same network",
      "a": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "same": true
    },
    {
      "name": "the host is not case sensitive",
      "a": {
        "host": "IRC.Netslum.IO",
        "port": 6697,
        "nick": "sbtest"
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "same": true
    },
    {
      "name": "nor is the nick, by the IRC casemap",
      "a": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "Kara[]"
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "kara{}"
      },
      "same": true
    },
    {
      "name": "surrounding space is not part of either",
      "a": {
        "host": " irc.netslum.io ",
        "port": 6697,
        "nick": " sbtest "
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "same": true
    },
    {
      "name": "two accounts on one server are two networks",
      "a": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest2"
      },
      "same": false
    },
    {
      "name": "a different port is a different network",
      "a": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "b": {
        "host": "irc.netslum.io",
        "port": 6667,
        "nick": "sbtest"
      },
      "same": false
    },
    {
      "name": "a different host is a different network",
      "a": {
        "host": "irc.netslum.io",
        "port": 6697,
        "nick": "sbtest"
      },
      "b": {
        "host": "irc.d0ll.link",
        "port": 6697,
        "nick": "sbtest"
      },
      "same": false
    }
