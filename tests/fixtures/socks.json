{
  "$comment": "SOCKS, byte for byte. Read by tests/shared/socks.test.ts and the Android SharedCorpusTest. SOCKS5 is RFC 1928 and its authentication RFC 1929; SOCKS4a is the extension that added hostnames. Both clients have to produce identical bytes or one of them talks to a proxy the other cannot.",
  "$greeting": "The opening hello. No authentication is always offered; a proxy wanting a password picks the other method.",
  "greeting": [
    {
      "name": "no credentials offers only 'none'",
      "hasCredentials": false,
      "bytes": [
        5,
        1,
        0
      ]
    },
    {
      "name": "credentials offer both, in preference order",
      "hasCredentials": true,
      "bytes": [
        5,
        2,
        0,
        2
      ]
    }
  ],
  "$choice": "Which method the proxy picked. Null means the two bytes have not both arrived.",
  "choice": [
    {
      "name": "no authentication wanted",
      "bytes": [
        5,
        0
      ],
      "method": 0
    },
    {
      "name": "password wanted",
      "bytes": [
        5,
        2
      ],
      "method": 2
    },
    {
      "name": "nothing we offered is acceptable",
      "bytes": [
        5,
        255
      ],
      "method": 255
    },
    {
      "name": "one byte is not an answer yet",
      "bytes": [
        5
      ],
      "method": null
    },
    {
      "name": "a version we do not speak is a refusal",
      "bytes": [
        4,
        0
      ],
      "method": 255
    }
  ],
