    {
      "name": "your name with a colon, the usual way",
      "text": "kara: are you there?",
      "nick": "kara",
      "mentions": true
    },
    {
      "name": "at the end of a sentence",
      "text": "that was thanks to kara",
      "nick": "kara",
      "mentions": true
    },
    {
