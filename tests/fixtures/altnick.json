      "alternatives": [
        "Kara",
        "kara2"
      ],
      "tried": [],
      "next": "kara2"
    },
    {
      "name": "blanks in the list are ignored",
      "attempted": "kara",
      "alternatives": [
        "",
        "  ",
        "kara2"
      ],
      "tried": [],
      "next": "kara2"
    }
  ]
