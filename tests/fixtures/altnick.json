{
  "$comment": "Which nick to try when the one asked for is taken: the user's alternatives in order, each once, then an underscore. Shared by tests/shared/nicks.test.ts and the Android SharedCorpusTest.",
  "cases": [
    {
      "name": "the first alternative",
      "attempted": "kara",
      "alternatives": [
        "kara_",
        "kara2"
