      "tried": [],
      "next": "kara_"
    },
    {
      "name": "the second, once the first was refused too",
      "attempted": "kara_",
      "alternatives": [
        "kara_",
        "kara2"
      ],
      "tried": [
        "kara"
      ],
      "next": "kara2"
    },
    {
      "name": "an underscore when they run out",
      "attempted": "kara2",
      "alternatives": [
        "kara_",
        "kara2"
      ],
      "tried": [
        "kara",
        "kara_"
      ],
      "next": "kara2_"
    },
    {
      "name": "no alternatives at all",
      "attempted": "kara",
      "alternatives": [],
      "tried": [],
      "next": "kara_"
    },
    {
      "name": "an alternative equal to what was just refused is skipped",
