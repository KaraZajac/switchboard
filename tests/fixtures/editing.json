{
  "$comment": "Which of your own messages you can still change. An edit is an ordinary PRIVMSG wearing a +draft/edit client tag, so a server without the capability relays it as a second message and leaves the original — worse than refusing. An action is CTCP-wrapped and the edit sends plain text, so amending one turns something you did into something you said. Both clients offer an Edit action and both got these wrong. Shared by tests/shared/editing.test.ts and the Android SharedCorpusTest.",
  "caps": ["draft/message-edit", "server-time", "echo-message"],
  "cases": [
    { "name": "your own line, on a server that carries edits", "type": "privmsg", "nick": "kara", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": true },
    { "name": "however the two spell the nick", "type": "privmsg", "nick": "KARA", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": true },
    { "name": "the ratified capability name too", "type": "privmsg", "nick": "kara", "deleted": false, "me": "kara", "caps": ["message-edit"], "can": true },
    { "name": "somebody else's line is not yours to amend", "type": "privmsg", "nick": "alice", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": false },
    { "name": "a server that does not carry edits would post it again", "type": "privmsg", "nick": "kara", "deleted": false, "me": "kara", "caps": ["server-time"], "can": false },
    { "name": "and one that says nothing at all", "type": "privmsg", "nick": "kara", "deleted": false, "me": "kara", "caps": [], "can": false },
    { "name": "an action is CTCP, and the edit is not", "type": "action", "nick": "kara", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": false },
    { "name": "a notice is not a message you send", "type": "notice", "nick": "kara", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": false },
    { "name": "nor is a line the client wrote itself", "type": "system", "nick": "kara", "deleted": false, "me": "kara", "caps": ["draft/message-edit"], "can": false },
    { "name": "one already taken back has nothing to amend", "type": "privmsg", "nick": "kara", "deleted": true, "me": "kara", "caps": ["draft/message-edit"], "can": false },
    { "name": "with no nick of our own, nothing is ours", "type": "privmsg", "nick": "kara", "deleted": false, "me": "", "caps": ["draft/message-edit"], "can": false }
  ],
