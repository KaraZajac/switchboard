{
  "$comment": "Which 'tell me when they turn up' command a network takes, shared by tests/shared/friends.test.ts and the Android SharedCorpusTest. Switchboard only ever spoke MONITOR, so on every bahamut and plexus network \u2014 DALnet and Rizon among them \u2014 the friend list was a screen you could add names to that would never tell you anything.",
  "$kinds": "`isupport` is what the network advertised; `kind` is what we should send, and `limit` how many names it will hold.",
  "kinds": [
    {
      "name": "solanum offers MONITOR",
      "isupport": {
        "MONITOR": "100"
      },
      "kind": "MONITOR",
      "limit": 100
    },
    {
      "name": "bahamut offers WATCH",
      "isupport": {
        "WATCH": "128"
      },
      "kind": "WATCH",
      "limit": 128
    },
    {
      "name": "UnrealIRCd offers both, and MONITOR is the better specified",
      "isupport": {
        "MONITOR": "128",
        "WATCH": "128"
      },
      "kind": "MONITOR",
      "limit": 128
    },
    {
      "name": "a bare MONITOR with no limit is still MONITOR",
      "isupport": {
        "MONITOR": true
      },
      "kind": "MONITOR",
      "limit": null
    },
    {
      "name": "hybrid on OFTC offers neither",
      "isupport": {
        "CALLERID": "g"
      },
      "kind": null,
      "limit": null
    }
  ],
  "$lines": "The lines to send. A friend list long enough to be useful is long enough to need more than one, and the names past a 512-byte cut were never watched at all.",
  "lines": [
    {
      "name": "MONITOR takes a comma-separated list",
      "kind": "MONITOR",
      "action": "add",
      "nicks": [
        "alice",
        "bob"
      ],
      "lines": [
        "MONITOR + alice,bob"
      ]
    },
    {
      "name": "MONITOR drops them the same way",
      "kind": "MONITOR",
      "action": "remove",
      "nicks": [
